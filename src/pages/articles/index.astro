---
import Base from '../../layouts/Base.astro';
const posts = Object.values(import.meta.glob('./*.md', { eager: true }))
  .filter(p => !p.frontmatter.draft)
  .sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date));
const [first, ...others] = posts;
---
<Base title="Articles · Le guide des hôtes Airbnb et Booking à Lyon et Villeurbanne" description="Prix, réglementation, avis, voyageurs : nos conseils concrets pour louer votre appartement sur Airbnb et Booking à Lyon et Villeurbanne.">
<section style="background: linear-gradient(180deg, #EEF2FF 0%, #FFFFFF 100%); padding: 80px 24px 48px">
 <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px">
  <p style="margin: 0; font-size: 14px; font-weight: 700; color: #1F4FFF; text-transform: uppercase; letter-spacing: 0.1em">Articles</p>
  <h1 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(38px, 5vw, 64px); line-height: 1.05; letter-spacing: -0.035em; max-width: 820px">Le guide des hôtes Airbnb et Booking à Lyon et Villeurbanne</h1>
  <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #4A5675; max-width: 640px">Prix, réglementation, avis, voyageurs : nos conseils concrets pour louer votre appartement plus souvent et au bon prix.</p>
 </div>
</section>
{first && (
<section style="padding: 24px 24px 64px">
 <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 40px; align-items: center; background: #F5F7FF; border: 1px solid #E2E7F5; border-radius: 20px; padding: 32px">
  <a href={first.url} tabindex="-1" aria-hidden="true" style="display: block">{first.frontmatter.image ? <img src={first.frontmatter.image} alt="" style="display: block; width: 100%; height: 300px; object-fit: cover; border-radius: 14px"> : <div style="height: 300px; border-radius: 14px; background: #1F4FFF"></div>}</a>
  <div style="display: flex; flex-direction: column; gap: 16px">
   <p style="margin: 0; font-size: 13px; font-weight: 700; color: #1F4FFF; text-transform: uppercase; letter-spacing: 0.08em">À la une · {first.frontmatter.category} · {first.frontmatter.readingTime}</p>
   <h2 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 36px; line-height: 1.12; letter-spacing: -0.03em"><a href={first.url} style="color: #0B1533; text-decoration: none">{first.frontmatter.title}</a></h2>
   <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #4A5675">{first.frontmatter.description}</p>
  </div>
 </div>
</section>)}
<section style="padding: 0 24px 96px">
 <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px 28px">
  {others.map(p => (
   <article style="display: flex; flex-direction: column; gap: 14px">
    <a href={p.url} tabindex="-1" aria-hidden="true" style="display: block">{p.frontmatter.image ? <img src={p.frontmatter.image} alt="" style="display: block; width: 100%; height: 180px; object-fit: cover; border-radius: 14px"> : <div style="height: 180px; border-radius: 14px; background: #E3E9FF"></div>}</a>
    <p style="margin: 0; font-size: 13px; font-weight: 700; color: #1F4FFF; text-transform: uppercase; letter-spacing: 0.08em">{p.frontmatter.category} · {p.frontmatter.readingTime}</p>
    <h3 style="margin: 0; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 21px; line-height: 1.3"><a href={p.url} style="color: #0B1533; text-decoration: none">{p.frontmatter.title}</a></h3>
    <p style="margin: 0; font-size: 15.5px; line-height: 1.55; color: #4A5675">{p.frontmatter.description}</p>
   </article>))}
 </div>
</section>
</Base>
