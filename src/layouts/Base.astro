---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { WA, CAL, WEBHOOK, COMM, TYPES, ZONES, SITE_NAME, GTAG_ID } from '../config.js';
const { title, description, schema = [], image } = Astro.props;
const ogImage = image ? new URL(image, Astro.site) : null;
const canonical = new URL(Astro.url.pathname, Astro.site);
const business = {
  "@context": "https://schema.org", "@type": "LocalBusiness", "name": SITE_NAME,
  "description": "Conciergerie Airbnb et Booking à Lyon et Villeurbanne : prix ajustés ensemble, remise des clés, ménage, urgences.",
  "url": Astro.site?.toString(), "areaServed": ["Villeurbanne", "Lyon"],
  "address": { "@type": "PostalAddress", "addressLocality": "Villeurbanne", "postalCode": "69100", "addressCountry": "FR" }
};
const cfg = `const GTAG_ID=${JSON.stringify(GTAG_ID)};const WA=${JSON.stringify(WA)};const CAL=${JSON.stringify(CAL)};const WEBHOOK=${JSON.stringify(WEBHOOK)};const COMM=${COMM};const TYPES=${JSON.stringify(TYPES)};const ZONES=${JSON.stringify(ZONES)};`;
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content="fr_FR">
{ogImage && <meta property="og:image" content={ogImage}>}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#1F4FFF">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap">
<style>
body{margin:0}
html{scroll-behavior:smooth}
a{color:#1F4FFF}a:hover{color:#0B1533}
</style>
<script type="application/ld+json" set:html={JSON.stringify([business, ...schema])}></script>
</head>
<body>
<div style="font-family: 'Inter', sans-serif; color: #0B1533; background: #FFFFFF; min-height: 100vh">
<Header />
<slot />
<Footer />
</div>
<script is:inline set:html={cfg}></script>
<div id="cookie-banner" hidden role="dialog" aria-label="Cookies" style="position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; max-width: 560px; margin: 0 auto; background: #FFFFFF; color: #0B1533; border: 1px solid #E2E7F5; border-radius: 16px; box-shadow: 0 20px 50px rgba(15, 23, 60, 0.18); padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; font-family: 'Inter', sans-serif">
 <p style="margin: 0; font-size: 15px; line-height: 1.55"><strong>Un petit clic pour un site encore meilleur ?</strong> Zéro pub, zéro revente de données : juste des statistiques de visite pour améliorer le site. On peut compter sur vous ? <a href="/confidentialite/" style="color: #1F4FFF">En savoir plus</a></p>
 <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end">
  <button type="button" id="cookie-refuse" style="min-height: 44px; padding: 0 18px; border-radius: 12px; border: 1.5px solid #C9D2EE; background: #FFFFFF; color: #0B1533; font-weight: 600; font-size: 15px; cursor: pointer; font-family: inherit">Refuser</button>
  <button type="button" id="cookie-accept" style="min-height: 44px; padding: 0 18px; border-radius: 12px; border: 0; background: #1F4FFF; color: #FFFFFF; font-weight: 600; font-size: 15px; cursor: pointer; font-family: inherit">Accepter</button>
 </div>
</div>
<script is:inline>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
(function(){
  var KEY = "gones-cookies";
  function read(){ try { return localStorage.getItem(KEY); } catch(e) { return null; } }
  function save(v){ try { localStorage.setItem(KEY, v); } catch(e) {} }
  var loaded = false;
  function loadTag(){
    if (loaded || !GTAG_ID) return; loaded = true;
    var s = document.createElement('script'); s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GTAG_ID;
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', GTAG_ID);
  }
  window.trackEvent = function(name, params){ if (loaded) gtag('event', name, params || {}); };
  var banner = document.getElementById('cookie-banner');
  function show(){ banner.hidden = false; banner.style.display = 'flex'; }
  function hide(){ banner.hidden = true; banner.style.display = 'none'; }
  document.getElementById('cookie-accept').addEventListener('click', function(){ save('granted'); hide(); loadTag(); });
  document.getElementById('cookie-refuse').addEventListener('click', function(){ save('denied'); hide(); });
  document.querySelectorAll('[data-cookies]').forEach(function(a){ a.addEventListener('click', function(e){ e.preventDefault(); show(); }); });
  var c = read();
  if (c === 'granted') loadTag(); else if (c !== 'denied') show(); else hide();
})();
</script>
<script is:inline>
// =============================

const $ = s => document.querySelector(s);
const f = n => n.toLocaleString("fr-FR") + " €";
let sim = {};

function compute(){
  if (!$("#f-zone")) { const v={waHello:"https://wa.me/"+WA+"?text="+encodeURIComponent("Bonjour, je souhaite en savoir plus sur la conciergerie les Gônes pour mon appartement."), calHref:CAL}; document.querySelectorAll("[data-href]").forEach(el=>{ if(v[el.dataset.href]) el.href=v[el.dataset.href]; }); return; }
  const z = ZONES[$("#f-zone").value], t = TYPES[$("#f-type").value], occ = +$("#f-occ").value;
  const price = Math.round(t[1]*z[1]), nights = Math.round(30*occ/100), gross = price*nights;
  const fee = Math.round(gross*COMM/100), net = gross - fee;
  sim = {quartier:z[0], type:t[0], occupation:occ, revenu_net:net};
  const msg = "Bonjour ! J’ai fait la simulation sur votre site : "+t[0]+" à "+z[0]+", environ "+f(net)+" net par mois. J’aimerais en parler avec vous.";
  const v = {occLabel:occ+" %", price:f(price), nights:nights+" nuits", gross:f(gross), fee:"− "+f(fee), net:f(net), year:f(net*12), typeLabel:t[0], zoneLabel:z[0],
    waHref:"https://wa.me/"+WA+"?text="+encodeURIComponent(msg),
    waHello:"https://wa.me/"+WA+"?text="+encodeURIComponent("Bonjour, je souhaite en savoir plus sur la conciergerie les Gônes pour mon appartement."),
    calHref:CAL+"?utm_source=site&utm_content="+encodeURIComponent(t[0]+" "+z[0]+" "+net+"€")};
  document.querySelectorAll("[data-k]").forEach(el => { if (v[el.dataset.k] !== undefined) el.textContent = v[el.dataset.k]; });
  document.querySelectorAll("[data-href]").forEach(el => el.href = v[el.dataset.href]);
}

function send(data){
  const body = new URLSearchParams({...sim, ...data, page: location.href, date: new Date().toISOString()});
  try { if (navigator.sendBeacon && navigator.sendBeacon(WEBHOOK, body)) return; } catch(e) {}
  fetch(WEBHOOK, {method:"POST", body, mode:"no-cors", keepalive:true}).catch(()=>{});
}

const onSim = !!$("#f-zone");
if (onSim) ["#f-zone","#f-type","#f-occ"].forEach(s => $(s).addEventListener("input", compute));
document.querySelectorAll("[data-track]").forEach(el => el.addEventListener("click", () => { send({source: el.dataset.track}); window.trackEvent && trackEvent(el.dataset.track === "Clic WhatsApp" ? "clic_whatsapp" : "clic_calendly", sim); }));
let simTracked = false;
if (onSim) ["#f-zone","#f-type","#f-occ"].forEach(s => $(s).addEventListener("input", () => { if (!simTracked) { simTracked = true; window.trackEvent && trackEvent("simulation", sim); } }));
document.querySelectorAll('a[target="_blank"]').forEach(a => a.rel = "noopener");

if ($("#lead-form")) $("#lead-form").addEventListener("submit", e => {
  e.preventDefault();
  window.trackEvent && trackEvent("generate_lead", {source: "Formulaire"});
  const d = Object.fromEntries(new FormData(e.target));
  d.consentement = d.consentement ? "oui" : "non";
  send({source:"Formulaire", ...d});
  $("#form-wrap").hidden = true; $("#form-thanks").hidden = false;
});
compute();

</script>
</body>
</html>
